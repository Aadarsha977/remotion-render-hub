{
  "name": "remotion-render-hub",
  "version": "1.0.0",
  "description": "Remotion video authored in Antigravity and rendered on Kaggle",
  "scripts": {
    "start": "remotion studio",
    "render": "powershell.exe -ExecutionPolicy Bypass -File ./render-cloud.ps1",
    "cloud:render": "powershell.exe -ExecutionPolicy Bypass -File ./render-cloud.ps1",
    "cloud:storyboard": "powershell.exe -ExecutionPolicy Bypass -File ./render-cloud.ps1 -StoryboardOnly",
    "cloud:video": "powershell.exe -ExecutionPolicy Bypass -File ./render-cloud.ps1 -VideoOnly"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.260",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.260"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
